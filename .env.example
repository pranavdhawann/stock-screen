# Required
GROQ_API_KEY=
SECRET_KEY=

# Optional - Server-side contact email
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Optional - Multi-source news aggregation (falls back to Yahoo Finance if not set)
GROQ_MODEL=llama-3.3-70b-versatile
NEWSAPI_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
CURRENTS_API_KEY=

# Optional - Supabase persistent cache (falls back to in-memory cache if not set)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# App settings
SEC_EDGAR_USER_AGENT=Stock Screen app@stockscreen.app
FLASK_ENV=production
PORT=8080
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=false
# Only used when TRUST_PROXY_HEADERS=true. Number of trusted reverse-proxy
# hops in front of this app; Cloud Run appends the real client IP as the
# LAST entry of X-Forwarded-For, so the default of 1 selects that last
# entry (never the client-controlled first entry).
TRUSTED_PROXY_HOPS=1
MAX_CONTENT_LENGTH=1048576
