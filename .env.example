# Required
GROQ_API_KEY=
SECRET_KEY=

# Optional - Server-side contact email
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Optional - Multi-source news aggregation (falls back to Yahoo Finance if not set)
GROQ_MODEL=llama-3.3-70b-versatile
NEWSAPI_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
CURRENTS_API_KEY=

# Optional - Supabase persistent cache (falls back to in-memory cache if not set)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# App settings
SEC_EDGAR_USER_AGENT=Stock Screen app@stockscreen.app
FLASK_ENV=production
PORT=8080
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=false
MAX_CONTENT_LENGTH=1048576
